{
  "name": "minidex-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "hardhat build",
    "compile": "hardhat build",
    "typecheck": "hardhat build && tsc --noEmit",
    "test": "hardhat test mocha",
    "node": "hardhat node --network hardhat",
    "deploy": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:ganache": "hardhat run scripts/deploy.ts --network ganache"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@openzeppelin/contracts": "5.4.0",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "chai": "6.3.0",
    "ethers": "6.17.0",
    "hardhat": "3.19.0",
    "mocha": "12.0.3",
    "typescript": "5.9.3"
  }
}
